        </mxCell>
        <mxCell id="KE1zYMi7UNZFZbIT8Z2D-108" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;res://&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;nbsp; Assets;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;gt; 2D&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;gt;&amp;gt; Usuarios_texturas&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; Navegacion&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; Imagenes&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;gt; 3D(Cada modelo tiene su texturas)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;gt;&amp;gt; carro_modelo&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(40, 119, 255));&quot;&gt;&amp;gt;&amp;gt;&amp;gt; Modelos_escenarios&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;Escenas:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(153, 255, 204); background-color: transparent;&quot;&gt;Escenas_2D:&amp;nbsp; (cada escena tiene su codigo dentro de la carpeta):&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt; Main_menu&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt; Menu_niveles&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;Menu_Introduccion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;Bienvenido_a_E_Rally&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;1&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;2&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;3&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;4&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;Rally_1&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;1&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;2&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;3&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;4&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;5&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;6&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;7&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;8&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;OPen_map&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; 3D_open_world&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;2&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;3&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;