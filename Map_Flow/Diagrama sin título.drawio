;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;3&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;4&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(153, 255, 204));&quot;&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;5&lt;/font&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="KE1zYMi7UNZFZbIT8Z2D-220">
